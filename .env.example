# Скопіюй у .env.local і встав свій ключ. .env* у .gitignore — у репо не потрапляє.
# Ключ живе тільки на сервері (/api/plan), ніколи не світиться на клієнті.

# Google AI Studio (Gemini). Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Вхід за кодом з пошти (lib/auth/emailCode.ts) ---

# Resend. Отримати: https://resend.com/api-keys
RESEND_API_KEY=

# Адреса відправника. Має бути на домені, підтвердженому в Resend (SPF+DKIM).
# Поки домен не підтверджено — лишити порожнім: піде дефолт onboarding@resend.dev,
# який дозволяє слати ЛИШЕ на адресу власника акаунта Resend.
EMAIL_FROM=

# Приватна бета: список адрес через кому, яким дозволено входити.
# ПОРОЖНЄ або незадане = пускати всіх (хибна конфігурація не замикає власника).
# Потрібне, поки домен не підтверджено: стороння адреса отримає чесне
# "private beta" замість незрозумілої помилки відправки.
AUTH_ALLOWED_EMAILS=
